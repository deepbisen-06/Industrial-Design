  <joint name="joint1_base_yaw" type="revolute">
    <parent link="base_link" />
    <child link="shoulder_link" />
    <origin xyz="0 0 0.1" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="50" velocity="1" />
    <dynamics damping=".1" friction=".05" />
  </joint>
  <joint name="joint2_shoulder" type="revolute">
    <parent link="shoulder_link" />
    <child link="upper_arm_link" />
    <origin xyz="0 0 0.1" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.5707963267948966" upper="1.5707963267948966" effort="40" velocity="1" />
    <dynamics damping=".1" friction=".05" />
  </joint>
  <joint name="joint3_elbow" type="revolute">
