    <child link="forearm_link" />
    <origin xyz="0 0 0.3" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.0943951023931953" upper="2.0943951023931953" effort="25" velocity="1.2" />
    <dynamics damping=".1" friction=".05" />
  </joint>
  <joint name="joint4_wrist" type="revolute">
